# Copy to .env and fill in. NEVER commit .env (it is gitignored and dockerignored).
#
# Everything here is OPTIONAL for the offline demo: `make demo` and the test
# suite need no keys and no network. Provider keys are only needed to talk to a
# real sandbox account, and they MUST be sandbox keys — the app refuses to boot
# otherwise:
#   RAZORPAY_KEY_ID must start with rzp_test_
#   STRIPE_API_KEY  must start with sk_test_

# Storage. SQLite by default; any SQLAlchemy URL works (Postgres-ready).
# The Docker image defaults to sqlite:////app/data/payment_recovery.db.
DATABASE_URL=sqlite:///./payment_recovery.db

# Razorpay (sandbox only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe (sandbox only)
STRIPE_API_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Fake provider webhook secret (offline runs and tests)
FAKE_WEBHOOK_SECRET=whsec_fake

# LLM (Groq, Llama 3.3 70B). Leave empty for fully offline runs (stub client).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Guardrails (money amounts in INR / rupees)
APPROVAL_THRESHOLD_INR=5000
PER_RUN_SPEND_CAP_INR=100000
PER_SUBJECT_ACTION_BUDGET=5
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30

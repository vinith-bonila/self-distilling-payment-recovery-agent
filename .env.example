# Copy to .env and fill in. NEVER commit .env.
# Provider keys MUST be sandbox keys or the app refuses to boot:
#   Razorpay key id must start with rzp_test_
#   Stripe api key must start with sk_test_

DATABASE_URL=sqlite:///./payment_recovery.db

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

STRIPE_API_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# LLM (Groq). Leave GROQ_API_KEY empty for fully offline runs (stub client).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Guardrails (money amounts in INR / rupees).
APPROVAL_THRESHOLD_INR=5000
PER_RUN_SPEND_CAP_INR=100000
PER_SUBJECT_ACTION_BUDGET=5
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30
